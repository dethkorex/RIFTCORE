config_version=5

[application]
config/icon="res://branding/riftcore-icon.svg"
config/windows_native_icon="res://branding/riftcore.ico"
config/name="RIFTCORE Launcher"
config/version="0.3.0"
run/main_scene="res://launcher.tscn"

[display]

display_server/driver.linuxbsd="wayland"
window/size/viewport_width=800
window/size/viewport_height=650
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
