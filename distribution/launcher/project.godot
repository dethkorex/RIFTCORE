config_version=5

[application]
config/icon="res://branding/riftcore-icon.svg"
config/windows_native_icon="res://branding/riftcore.ico"
config/name="RIFTCORE Launcher"
run/main_scene="res://launcher.tscn"

[display]

display_server/driver.linuxbsd="wayland"
window/size/viewport_width=650
window/size/viewport_height=660
window/size/resizable=false

[rendering]
renderer/rendering_method="gl_compatibility"

[gui]

theme/custom_font="res://branding/BarlowCondensed-ExtraBoldItalic.ttf"
